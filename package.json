{
  "name": "@arcade-cabinet/rpgjs-patches",
  "version": "0.1.2",
  "description": "Reusable CanvasEngine compatibility patches for standalone RPGJS games.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "repository": {
    "type": "git",
    "url": "ssh://gitea@github.com/arcade-cabinet/rpgjs-patches.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.15.1",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && node scripts/postbuild.mjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "node scripts/build-cjs.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && node scripts/smoke-package.mjs"
  },
  "peerDependencies": {
    "canvasengine": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "canvasengine": "2.0.1",
    "esbuild": "0.28.1",
    "pixi.js": "8.19.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
